{
  "name": "@repotools/chrome-extension-bridge",
  "version": "1.0.0",
  "description": "WebSocket bridge server for Repotools Chrome Extension",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc -w & nodemon dist/index.js",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "ws": "^8.18.2",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "axios": "^1.6.7",
    "uuid": "^11.1.0",
    "eventsource": "^2.0.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "@types/express": "^4.17.22",
    "@types/cors": "^2.8.18",
    "@types/uuid": "^10.0.0",
    "@types/eventsource": "^1.1.15",
    "@types/node": "^22.13.14",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.3",
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}